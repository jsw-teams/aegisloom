{
  "name": "edgeaegis",
  "version": "2026.10.4",
  "description": "First-party portable SecLang engine with complete OWASP CRS execution",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "edgeaegis": "tools/.build/scr/cli/main.js"
  },
  "exports": {
    ".": "./tools/.build/scr/runtime/index.js",
    "./node": "./tools/.build/scr/runtime/node.js",
    "./http-boundary": "./tools/.build/scr/http-boundary/index.js",
    "./cloudflare-runtime": "./tools/.build/scr/adapters/cloudflare/runtime.js",
    "./portable-runtime": "./tools/.build/scr/adapters/runtime.js",
    "./ingress": "./tools/.build/scr/adapters/forward.js",
    "./relay": "./tools/.build/scr/origin/relay.js",
    "./relay/node": "./tools/.build/scr/origin/replay-node.js",
    "./seclang": "./tools/.build/scr/seclang/index.js",
    "./seclang/syntax": "./tools/.build/scr/seclang/syntax.js",
    "./seclang/node": "./tools/.build/scr/seclang/node.js",
    "./seclang/pcre2.wasm": "./tools/.build/scr/seclang/vendor/pcre2.wasm",
    "./seclang/libinjection.wasm": "./tools/.build/scr/seclang/vendor/libinjection.wasm",
    "./build": "./tools/build-platform.mjs",
    "./deployment": "./tools/.build/scr/cli/deployment.js",
    "./config": "./tools/.build/scr/config.js",
    "./responses": "./tools/.build/scr/runtime/error-pages.js"
  },
  "files": [
    "tools/.build/scr",
    "config.yml",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "NOTICE",
    "rules/seclang-bundle.json",
    "rules/config.yml",
    "rules/seclang-upstreams.json",
    "rules/allowlist.yml",
    "rules/local.conf",
    "rules/setup.conf",
    "rules/emergency.conf",
    "secret/credentials.example.yml",
    "secret/relay-server.example.yml",
    "origin",
    "respond",
    "tools/sync-native-seclang.mjs",
    "tools/verify-full-crs.mjs",
    "tools/build-platform.mjs",
    "tools/platform-command.mjs"
  ],
  "scripts": {
    "build": "node tools/clean-build.mjs && node tools/run.mjs tsc -p tsconfig.build.json && node tools/copy-seclang-assets.mjs",
    "typecheck": "node tools/run.mjs tsc --noEmit",
    "lint": "node tools/run.mjs biome check scr tools",
    "format": "node tools/run.mjs biome check --write scr tools",
    "secret:init": "node tools/init-secret.mjs",
    "relay:init": "node tools/init-relay.mjs",
    "test": "node --import ./tools/node_modules/tsx/dist/loader.mjs --test tools/tests/*.test.ts",
    "test:unit": "node --import ./tools/node_modules/tsx/dist/loader.mjs --test tools/tests/seclang-*.test.ts tools/tests/allowlist.test.ts tools/tests/error-pages.test.ts tools/tests/dependency-maintenance.test.ts",
    "test:integration": "node --import ./tools/node_modules/tsx/dist/loader.mjs --test tools/tests/proxy.test.ts tools/tests/serve.test.ts",
    "test:security": "node --import ./tools/node_modules/tsx/dist/loader.mjs --test tools/tests/security.test.ts",
    "serve": "node tools/.build/scr/cli/main.js serve config.yml",
    "test:crs": "node tools/sync-native-seclang.mjs",
    "verify:package": "node tools/verify-package.mjs",
    "check": "npm run version:check && npm run typecheck && npm run lint && npm test && npm run build && npm run check:edge && npm run verify:package",
    "check:edge": "node --experimental-vm-modules tools/check-edge.mjs",
    "test:workerd": "node --import ./tools/node_modules/tsx/dist/loader.mjs --test tools/tests/seclang-workerd.test.ts",
    "cloudflare:dry-run": "node tools/cloudflare-dry-run.mjs",
    "version": "node tools/sync-version.mjs",
    "version:check": "node tools/sync-version.mjs --check",
    "prepare": "node tools/bootstrap.mjs && node tools/init-secret.mjs && npm run build",
    "audit": "node tools/audit-dependencies.mjs moderate",
    "deps:repair": "node .github/actions/dependency-maintenance/repair.mjs",
    "build:cloudflare": "node tools/.build/scr/cli/main.js build cloudflare",
    "start:cloudflare": "node tools/.build/scr/cli/main.js start cloudflare",
    "deploy:cloudflare": "node tools/.build/scr/cli/main.js deploy cloudflare",
    "build:vercel": "node tools/.build/scr/cli/main.js build vercel",
    "start:vercel": "node tools/.build/scr/cli/main.js start vercel",
    "deploy:vercel": "node tools/.build/scr/cli/main.js deploy vercel",
    "build:netlify": "node tools/.build/scr/cli/main.js build netlify",
    "start:netlify": "node tools/.build/scr/cli/main.js start netlify",
    "deploy:netlify": "node tools/.build/scr/cli/main.js deploy netlify",
    "build:esa": "node tools/.build/scr/cli/main.js build esa",
    "start:esa": "node tools/.build/scr/cli/main.js start esa",
    "deploy:esa": "node tools/.build/scr/cli/main.js deploy esa",
    "build:edgeone": "node tools/.build/scr/cli/main.js build edgeone",
    "start:edgeone": "node tools/.build/scr/cli/main.js start edgeone",
    "deploy:edgeone": "node tools/.build/scr/cli/main.js deploy edgeone",
    "build:local": "node tools/.build/scr/cli/main.js build local",
    "start:local": "node tools/.build/scr/cli/main.js start local",
    "deploy:local": "node tools/.build/scr/cli/main.js deploy local",
    "deploy": "npm run deploy:cloudflare"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@xmldom/xmldom": "^0.9.12",
    "ipaddr.js": "^2.5.0",
    "xpath": "^0.0.35",
    "yaml": "^2.9.1",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.6",
    "acorn": "^8.19.0",
    "miniflare": "5.20261019.2-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsw-teams/edgeaegis.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
