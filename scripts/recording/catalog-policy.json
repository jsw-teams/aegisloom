{
  "version": "1",
  "rules": [
    {
      "id": "numeric-item-id",
      "name": "Enforce the catalog's positive integer ID contract",
      "service": "api",
      "priority": 10,
      "when": {
        "all": [
          { "field": "path", "op": "eq", "value": "/api/items" },
          { "field": "query", "key": "id", "op": "exists", "value": true },
          { "field": "query", "key": "id", "op": "regex", "value": "(^$|^0|[^0-9])" }
        ]
      },
      "then": { "action": "block" },
      "cache": { "enabled": true, "ttl": "5m" },
      "community": { "report": false }
    }
  ]
}
