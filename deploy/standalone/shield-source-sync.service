[Unit]
Description=Synchronize public and private security rule candidates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=shield
Group=shield
WorkingDirectory=/opt/shield
EnvironmentFile=/etc/shield/rule-secrets.env
ExecStart=/usr/bin/node /opt/shield/dist/packages/cli/main.js sources-sync /etc/shield/sources.yaml /var/lib/shield/candidates.db
StateDirectory=shield
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/shield
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
