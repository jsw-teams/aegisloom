{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "api-shield-validation",
  "send_metrics": false,
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 */6 * * *"] },
  "routes": [],
  "vars": {
    "TENANT": "validation",
    "SERVICE": "api",
    "PUBLIC_HOST": "shield-test.example.com",
    "ORIGIN": "https://isolated-origin.example.com",
    "CONTROL_ORIGIN": "https://isolated-control.example.com",
    "POLICY": "{\"version\":\"1\",\"rules\":[]}",
    "ROUTES": [{ "path": "/api", "methods": ["GET"], "authenticated": true }]
  }
}
