# Operator-owned OpenResty/NGINX profile for self-hosted VPS only.
# Render placeholders with render.mjs; never commit generated configs or certificates.
worker_processes 1;
pid __PID_FILE__;
events { worker_connections 256; }
http {
    default_type application/octet-stream;
    access_log off;
    error_log __ERROR_LOG__ warn;
    server_tokens off;
    server {
        listen 127.0.0.1:__BRIDGE_PORT__;
        server_name _;
        if ($http_x_shield_origin_auth != "__ORIGIN_TOKEN__") { return 403; }
        location / {
            proxy_pass https://__UPSTREAM_HOST__:__UPSTREAM_PORT__;
            proxy_http_version 1.1;
            proxy_set_header Host __UPSTREAM_HOST__;
            proxy_set_header Connection "";
            proxy_set_header X-Shield-Origin-Auth "__ORIGIN_TOKEN__";
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Real-IP "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_ssl_server_name on;
            proxy_ssl_name __UPSTREAM_HOST__;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate __UPSTREAM_CA_FILE__;
            proxy_ssl_verify_depth 3;
            proxy_connect_timeout 5s;
            proxy_send_timeout 20s;
            proxy_read_timeout 20s;
            proxy_buffering off;
            proxy_next_upstream off;
        }
    }
    server {
        listen __INGRESS_BIND__:__INGRESS_PORT__ ssl;
        server_name __PUBLIC_HOST__;
        ssl_certificate __TLS_CERT_FILE__;
        ssl_certificate_key __TLS_KEY_FILE__;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        client_max_body_size 2m;
        location / {
            proxy_pass http://127.0.0.1:__ENGINE_PORT__;
            proxy_http_version 1.1;
            proxy_set_header Host __PUBLIC_HOST__;
            proxy_set_header Connection "";
            proxy_set_header X-Shield-Origin-Auth "";
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Real-IP "";
            proxy_set_header X-Forwarded-Proto https;
            proxy_connect_timeout 5s;
            proxy_send_timeout 20s;
            proxy_read_timeout 20s;
            proxy_buffering off;
            proxy_next_upstream off;
        }
    }
}
