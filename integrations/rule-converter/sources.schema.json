{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jsw-teams/shieldweave/sources-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "upstreams", "ruleSources", "permittedLicenses"],
  "properties": {
    "version": { "const": "1" },
    "permittedLicenses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "upstreams": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "origin", "originTokenEnv", "timeoutMs", "maxResponseBytes"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "kind": { "enum": ["cloud", "vps", "local"] },
          "origin": { "type": "string", "minLength": 9, "maxLength": 2048 },
          "originTokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
          "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
        }
      }
    },
    "ruleSources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "location", "format", "version", "license", "service"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "enabled": { "type": "boolean" },
          "location": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "format": {
            "enum": ["shield-ir", "seclang", "crowdsec-appsec", "suricata", "sigma", "nuclei"]
          },
          "version": { "type": "string", "minLength": 1, "maxLength": 128 },
          "license": { "type": "string", "minLength": 1, "maxLength": 128 },
          "service": { "$ref": "#/definitions/id" },
          "authTokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
          "regressionFile": { "type": "string", "minLength": 1, "maxLength": 512 },
          "conversionReportFile": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  },
  "definitions": { "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" } }
}
