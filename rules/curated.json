{
  "version": "1",
  "rules": [
    {
      "id": "scan-env",
      "name": "Prevent exposure of dotenv files",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "path",
        "op": "regex",
        "value": "(?:^|/)\\.env(?:[./]|$)",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    },
    {
      "id": "scan-git",
      "name": "Prevent exposure of git internals",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "path",
        "op": "regex",
        "value": "(?:^|/)\\.git(?:/|$)",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    },
    {
      "id": "scan-svn",
      "name": "Prevent exposure of svn internals",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "path",
        "op": "regex",
        "value": "(?:^|/)\\.svn(?:/|$)",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    },
    {
      "id": "scan-hg",
      "name": "Prevent exposure of hg internals",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "path",
        "op": "regex",
        "value": "(?:^|/)\\.hg(?:/|$)",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    },
    {
      "id": "scan-wp-config",
      "name": "Block WordPress config file downloads",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "path",
        "op": "regex",
        "value": "(?:^|/)wp-config\\.php(?:/|$)",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    },
    {
      "id": "scan-aws-keys",
      "name": "Block AWS shared credentials downloads",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "path",
        "op": "regex",
        "value": "(?:^|/)\\.aws/credentials(?:/|$)",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    },
    {
      "id": "scan-docker-config",
      "name": "Block Docker auth config downloads",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "path",
        "op": "regex",
        "value": "(?:^|/)\\.docker/config\\.json(?:/|$)",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    },
    {
      "id": "scan-actuator-secrets",
      "name": "Block sensitive actuator introspection endpoints",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "path",
        "op": "regex",
        "value": "^/actuator/(?:env|heapdump|configprops|logfile)(?:/|$)",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    },
    {
      "id": "scan-debug-pprof",
      "name": "Block public pprof debug endpoints",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "path",
        "op": "regex",
        "value": "^/debug/pprof(?:/|$)",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    },
    {
      "id": "scan-server-status",
      "name": "Block public server-status endpoint",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "path",
        "op": "regex",
        "value": "^/server-status(?:/|$)",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    },
    {
      "id": "scan-phpunit-eval",
      "name": "Block known PHPUnit eval-stdin probing",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "path",
        "op": "regex",
        "value": "(?:^|/)vendor/phpunit/phpunit/src/util/php/eval-stdin\\.php$",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    },
    {
      "id": "scan-ds-store",
      "name": "Prevent macOS metadata file exposure",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "path",
        "op": "regex",
        "value": "(?:^|/)\\.ds_store(?:/|$)",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    },
    {
      "id": "query-union-select",
      "name": "High confidence SQL UNION query probe",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "query.all",
        "op": "regex",
        "value": "union\\s+(?:all\\s+)?select\\s+",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      }
    },
    {
      "id": "query-sleep-probe",
      "name": "Time-delay SQL probing",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "query.all",
        "op": "regex",
        "value": "(?:sleep|benchmark)\\s*\\(",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      }
    },
    {
      "id": "query-script-tag",
      "name": "Literal script-tag query probe",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "query.all",
        "op": "regex",
        "value": "<script(?:[\\s>/])",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      }
    },
    {
      "id": "header-jndi-probe",
      "name": "Log4Shell JNDI marker in user-agent",
      "service": "api",
      "phase": "request-headers",
      "placement": "runtime-required",
      "when": {
        "field": "header.all",
        "op": "contains",
        "value": "${jndi:",
        "transforms": [
          "lowercase"
        ]
      },
      "then": {
        "action": "block"
      },
      "priority": 100
    }
  ]
}
