      "id": "query-sleep-probe",
      "name": "Time-delay SQL probing",
      "service": "api",
      "when": {
        "any": [
          {
            "field": "query",
            "key": "q",
            "op": "regex",
            "value": "(?:sleep|benchmark)\\s*\\(",
            "transforms": [
              "lowercase"
            ]
          },
          {
            "field": "query",
            "key": "search",
            "op": "regex",
            "value": "(?:sleep|benchmark)\\s*\\(",
            "transforms": [
              "lowercase"
            ]
          },
          {
            "field": "query",
            "key": "id",
            "op": "regex",
            "value": "(?:sleep|benchmark)\\s*\\(",
            "transforms": [
              "lowercase"
            ]
          },
          {
            "field": "query",
            "key": "filter",
            "op": "regex",
            "value": "(?:sleep|benchmark)\\s*\\(",
            "transforms": [
              "lowercase"
            ]
          },
          {
            "field": "query",
            "key": "redirect",
            "op": "regex",
            "value": "(?:sleep|benchmark)\\s*\\(",
            "transforms": [
              "lowercase"
            ]
          },
          {
            "field": "query",
            "key": "url",
            "op": "regex",
            "value": "(?:sleep|benchmark)\\s*\\(",
            "transforms": [
              "lowercase"
            ]
          }
        ]
      },
      "then": {
        "action": "block"
