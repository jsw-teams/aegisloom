      "id": "query-script-tag",
      "name": "Literal script-tag query probe",
      "service": "api",
      "when": {
        "any": [
          {
            "field": "query",
            "key": "q",
            "op": "regex",
            "value": "<script(?:[\\s>/])",
            "transforms": [
              "lowercase"
            ]
          },
          {
            "field": "query",
            "key": "search",
            "op": "regex",
            "value": "<script(?:[\\s>/])",
            "transforms": [
              "lowercase"
            ]
          },
          {
            "field": "query",
            "key": "id",
            "op": "regex",
            "value": "<script(?:[\\s>/])",
            "transforms": [
              "lowercase"
            ]
          },
          {
            "field": "query",
            "key": "filter",
            "op": "regex",
            "value": "<script(?:[\\s>/])",
            "transforms": [
              "lowercase"
            ]
          },
          {
            "field": "query",
            "key": "redirect",
            "op": "regex",
            "value": "<script(?:[\\s>/])",
            "transforms": [
              "lowercase"
            ]
          },
          {
            "field": "query",
            "key": "url",
            "op": "regex",
            "value": "<script(?:[\\s>/])",
            "transforms": [
              "lowercase"
            ]
          }
        ]
      },
      "then": {
        "action": "block"
      },
      "provenance": {
        "source": "curated.json",
        "version": "reviewed-v2",
        "sha256": "6c779f1d405fbacff439aaa5ecd998584e33ddb3bd9956c7ae3d6fe88b66bd67",
        "license": "Apache-2.0",
