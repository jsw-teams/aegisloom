{
  "version": "1",
  "rules": [
    {
      "enabled": true,
      "priority": 100,
      "phase": "request-headers",
      "placement": "runtime-required",
      "cache": {
        "enabled": false,
        "ttl": "1m"
      },
      "community": {
        "report": false
      },
      "id": "header-jndi-probe",
      "name": "Log4Shell JNDI marker in user-agent",
      "service": "api",
      "when": {
        "field": "header",
        "op": "contains",
        "value": "${jndi:",
        "transforms": [
          "lowercase"
        ],
        "key": "user-agent"
      },
      "then": {
        "action": "block"
      },
      "provenance": {
        "source": "curated.json",
        "version": "reviewed-v2",
        "sha256": "6c779f1d405fbacff439aaa5ecd998584e33ddb3bd9956c7ae3d6fe88b66bd67",
        "license": "Apache-2.0",
        "limitations": []
      }
    },
