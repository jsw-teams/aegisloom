{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cloud-shieldweave.invalid/schemas/rule-ir-v1.json",
  "title": "Shield Rule IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules"],
  "properties": {
    "version": { "const": "1" },
    "rules": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "duration": { "type": "string", "pattern": "^[1-9][0-9]{0,5}(ms|s|m|h)$", "maxLength": 9 },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moreThan", "within", "groupBy"],
      "properties": {
        "moreThan": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "within": { "$ref": "#/$defs/duration" },
        "groupBy": { "enum": ["verifiedClientIp", "identity"] }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "op"],
      "properties": {
        "field": {
          "enum": [
            "path",
            "method",
            "header",
            "query",
            "query.all",
            "header.all",
            "body",
            "identity",
            "client.ip",
            "client.class",
            "risk.score"
          ]
        },
        "key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "op": { "enum": ["eq", "contains", "prefix", "regex", "exists", "range"] },
        "value": { "type": ["string", "number", "boolean"], "maxLength": 512 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "transforms": {
          "type": "array",
          "maxItems": 3,
          "items": { "enum": ["lowercase", "trim", "urlDecode"] }
        }
      }
    },
    "expression": {
      "oneOf": [
        { "$ref": "#/$defs/match" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/expression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/expression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/expression" } }
        }
      ]
    },
    "simple": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "method": { "type": "string", "pattern": "^[A-Z]{1,20}$" },
        "requests": { "$ref": "#/$defs/rate" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "service", "when", "then"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 2048 },
        "enabled": { "type": "boolean", "default": true },
        "service": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000000, "default": 100 },
        "phase": {
          "enum": ["request-headers", "request-body", "response-headers"],
          "default": "request-headers"
        },
        "placement": {
          "enum": ["edge-required", "edge-preferred", "runtime-required", "upstream-required"],
          "default": "runtime-required"
        },
        "when": { "oneOf": [{ "$ref": "#/$defs/expression" }, { "$ref": "#/$defs/simple" }] },
        "requests": { "$ref": "#/$defs/rate" },
        "then": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {
            "action": { "enum": ["block", "detect", "rate-limit", "challenge"] },
            "duration": { "$ref": "#/$defs/duration" },
            "score": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "ttl"],
          "properties": { "enabled": { "type": "boolean" }, "ttl": { "$ref": "#/$defs/duration" } }
        },
        "community": {
          "type": "object",
          "additionalProperties": false,
          "required": ["report"],
          "properties": { "report": { "type": "boolean" } }
        },
        "expiresAt": { "type": "string", "maxLength": 30 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "version", "license", "sha256", "limitations"],
          "properties": {
            "source": { "type": "string", "maxLength": 1024 },
            "version": { "type": "string", "maxLength": 128 },
            "license": { "type": "string", "maxLength": 128 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "limitations": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "maxLength": 2048 }
            }
          }
        }
      }
    }
  }
}
